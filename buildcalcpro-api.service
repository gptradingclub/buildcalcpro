[Unit]
Description=BuildCalc Pro API Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/buildcalcpro
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/etc/buildcalcpro/secrets.env
ExecStart=/usr/local/bin/gunicorn --bind 127.0.0.1:5050 --workers 2 --timeout 60 --access-logfile /var/log/buildcalcpro-access.log --error-logfile /var/log/buildcalcpro-error.log server:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
